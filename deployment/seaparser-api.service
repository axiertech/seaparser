[Unit]
Description=SeaParser synthetic planning API
After=network.target

[Service]
Type=simple
User=seaparser
Group=seaparser
WorkingDirectory=/home/web/seaparser/app
ExecStart=/home/web/seaparser/app/.venv/bin/python -B -m uvicorn api.main:app --host 127.0.0.1 --port 8765 --workers 1 --limit-concurrency 16 --timeout-keep-alive 5 --no-access-log --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
InaccessiblePaths=/home/web/seaparser/config
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=512M
CPUQuota=200%
TasksMax=32

[Install]
WantedBy=multi-user.target
