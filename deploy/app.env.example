# Exempel utan hemligheter. Fyll i privat på servern.
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=seaparser
DB_USER=seaparser
DB_PASSWORD=
# Endast require, verify-ca eller verify-full; inga okrypterade lägen.
DB_SSLMODE=require
# Absolut sökväg till betrodd CA utanför Git; obligatorisk för verify-ca/full.
DB_SSLROOTCERT=
